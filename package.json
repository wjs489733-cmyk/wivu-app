{
  "name": "wivu-app",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tokens:figma": "node scripts/figma-to-dtcg.mjs",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "tokens": "npm run tokens:figma && npm run tokens:build",
    "icons": "node scripts/build-icons.mjs",
    "font:subset": "python3 scripts/subset-font.py",
    "build:single": "tsc -b && vite build --mode single",
    "artifact": "npm run build:single && node scripts/to-artifact.mjs",
    "screen-map": "node scripts/screen-map.mjs",
    "crawl": "node scripts/crawl.mjs"
  },
  "dependencies": {
    "motion": "^14.1.0",
    "pretendard": "^1.3.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.0",
    "style-dictionary": "^5.6.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "description": "WivU — 대학생 통합 앱 코드 프로토타입 (졸업전시 기술실증)"
}

{
  "font": {
    "family": {
      "$type": "fontFamily",
      "base": {
        "$value": [
          "Pretendard Variable",
          "Pretendard",
          "-apple-system",
          "BlinkMacSystemFont",
          "system-ui",
          "Apple SD Gothic Neo",
          "Noto Sans KR",
          "sans-serif"
        ],
        "$extensions": {
          "com.wivu": {
            "source": "code",
            "note": "10-12 결정: 최종 폰트 Pretendard (Figma 스타일은 작업용 SF Pro)"
          }
        }
      }
    }
  },
  "type": {
    "$type": "typography",
    "display": {
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontWeight": 700,
        "fontSize": {
          "value": 28,
          "unit": "px"
        },
        "lineHeight": 1.2857,
        "letterSpacing": {
          "value": -0.01,
          "unit": "em"
        }
      },
      "$extensions": {
        "com.figma": {
          "source": "figma",
          "style": "WivU Type/Display",
          "lineHeightPx": 36
        }
      }
    },
